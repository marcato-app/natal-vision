# Copie este arquivo para .env e preencha. Sem as chaves do Firebase o app roda em modo demonstração.

# Firebase: Console do Firebase > Configurações do projeto > Seus apps > App da Web
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# AdSense (site). Ex.: ca-pub-1234567890123456 e o ID do bloco de anúncio
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT=

# AdMob (apps). Deixe vazio para usar os anúncios de TESTE do Google.
VITE_ADMOB_ANDROID_BANNER=
VITE_ADMOB_ANDROID_INTER=
VITE_ADMOB_ANDROID_REWARD=
VITE_ADMOB_IOS_BANNER=
VITE_ADMOB_IOS_INTER=
VITE_ADMOB_IOS_REWARD=
